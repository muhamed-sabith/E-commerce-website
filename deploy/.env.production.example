# Template for deploy/docker-compose.prod.yml. Copy to deploy/.env.production
# (gitignored) and replace EVERY value. Placeholders below are rejected by the
# API at startup on purpose.

# Public origin of the storefront (https, no path). Also the CORS origin.
PUBLIC_SITE_URL=https://REPLACE_WITH_YOUR_DOMAIN

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS

POSTGRES_USER=heyrah
POSTGRES_DB=heyrah
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://heyrah:REPLACE_WITH_A_STRONG_DB_PASSWORD@postgres:5432/heyrah

# Reverse proxies in front of the API: TLS proxy + web container = 2.
TRUST_PROXY_HOPS=2

# Final shipping amounts are a business decision (INR, up to 2 decimals).
# They can also be changed later in admin → Settings.
SHIPPING_FLAT_RATE=REPLACE_WITH_AMOUNT
SHIPPING_FREE_THRESHOLD=REPLACE_WITH_AMOUNT

WEB_PORT=8080

# HEYRAH — environment template
# Copy to the right location and adjust: api/.env, web/.env

# --- api/.env ---
PORT=4000
DATABASE_URL=postgresql://postgres@localhost:5432/heyrah_dev
# 32+ chars; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-32-plus-characters-long-secret
API_ALLOWED_ORIGIN=http://localhost:5173
NODE_ENV=development

# Sessions (docs/AUTHENTICATION.md) — defaults shown
SESSION_ABSOLUTE_TTL_HOURS=168
SESSION_IDLE_TTL_HOURS=24

# Auth rate limiting (API_CONTRACT §9 default: 10/min/IP)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Admin bootstrap (npm run bootstrap:admin in the api workspace)
ADMIN_EMAIL=admin@heyrah.test
ADMIN_PASSWORD=replace-me-min-10-chars
ADMIN_NAME=HEYRAH Admin

# --- web/.env ---
VITE_API_URL=http://localhost:4000

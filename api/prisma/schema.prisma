// HEYRAH — Prisma schema.
// Mirrors docs/DATABASE_SCHEMA.md (v0.3), which stays the relational source
// of truth. Phase 5 scope: catalog tables. Phase 6 adds §2.1 users plus the
// §11.4 server-side session store. No speculative models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// §2.1 users — identity + role; sessions are the authz runtime evidence
model User {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  name         String    @db.VarChar(120) // required, trimmed
  email        String    @unique @db.VarChar(255) // normalized lowercase
  passwordHash String    @map("password_hash") @db.VarChar(255) // bcrypt output; plaintext never exists here
  role         String    @default("USER") @db.VarChar(10) // CHECK-in ('USER','ADMIN') enforced by migration SQL
  isBlocked    Boolean   @default(false) @map("is_blocked") // admin action (§3.10)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]
  cart     Cart?

  @@map("users")
}

/// §11.4 sessions — server-side state for instant revocation. The PK is the
/// sha256 hash of the cookie token: a stolen DB dump yields no usable cookies.
/// user_id NULL = guest session (cart phase keys off these).
model Session {
  id           String   @id @db.VarChar(64) // hex(sha256(token))
  userId       BigInt?  @map("user_id") @db.BigInt
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6) // absolute ceiling
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6) // idle expiry basis
  rotatedFrom  String?  @map("rotated_from") @db.VarChar(64) // audit chain of login rotation
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// §2.6 carts — exactly one identity: user_id (persistent user cart) XOR
/// session_token (guest's temporary session cart, keyed by the unauthenticated
/// session). The XOR is enforced by migration SQL; one active cart per user
/// via the partial unique index.
model Cart {
  id           BigInt     @id @default(autoincrement()) @db.BigInt
  userId       BigInt?    @unique @map("user_id") @db.BigInt
  sessionToken String?    @unique @map("session_token") @db.VarChar(64) // sha256 of the guest session token
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([sessionToken])
  @@map("carts")
}

/// §2.6 cart_items — one line per product per cart (UNIQUE enforced in SQL);
/// quantity > 0 (CHECK in SQL). Adding twice merges quantity in the service.
model CartItem {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  cartId    BigInt   @map("cart_id") @db.BigInt
  productId BigInt   @map("product_id") @db.BigInt
  quantity  Int      // CHECK (> 0 AND <= 99) enforced by migration SQL
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

/// §2.2 categories
model Category {
  id        BigInt    @id @default(autoincrement()) @db.BigInt
  name      String    @db.VarChar(80)
  slug      String    @unique @db.VarChar(90) // URL-safe, stable
  isActive  Boolean   @default(true) @map("is_active") // inactive → hidden from storefront
  sortOrder Int       @default(0) @map("sort_order") // nav display order
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  Product[]

  @@map("categories")
}

/// §2.3 products — money is NUMERIC, never float, never string
model Product {
  id                BigInt   @id @default(autoincrement()) @db.BigInt
  name              String   @db.VarChar(120)
  slug              String   @unique @db.VarChar(140) // derived, stable
  sku               String   @unique @db.VarChar(40) // uppercase, HEY-<CAT>-#####
  description       String   @db.Text
  price             Decimal  @db.Decimal(10, 2) // CHECK (price > 0) enforced by migration SQL
  discountType      String   @default("none") @map("discount_type") @db.VarChar(10) // CHECK-in ('none','percent','fixed')
  discountValue     Decimal? @map("discount_value") @db.Decimal(10, 2)
  categoryId        BigInt   @map("category_id") @db.BigInt
  status            String   @default("active") @db.VarChar(12) // CHECK-in ('active','inactive','archived')
  stockQuantity     Int      @default(0) @map("stock_quantity") // CHECK (>= 0) enforced by migration SQL
  lowStockThreshold Int?     @map("low_stock_threshold")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category       Category               @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  specifications ProductSpecification[]
  cartItems      CartItem[]

  @@index([categoryId])
  @@index([status, stockQuantity])
  @@index([price])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

/// §2.4 product_images — position 0 = primary
model ProductImage {
  id        BigInt @id @default(autoincrement()) @db.BigInt
  productId BigInt @map("product_id") @db.BigInt
  filePath  String @map("file_path") @db.VarChar(255)
  altText   String @map("alt_text") @db.VarChar(200)
  position  Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_images")
}

/// §2.5 product_specifications — key/value pairs
model ProductSpecification {
  id        BigInt @id @default(autoincrement()) @db.BigInt
  productId BigInt @map("product_id") @db.BigInt
  specKey   String @map("spec_key") @db.VarChar(60)
  specValue String @map("spec_value") @db.VarChar(255)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, specKey])
  @@map("product_specifications")
}
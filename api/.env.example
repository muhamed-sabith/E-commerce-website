# HEYRAH api — Express + Prisma (TypeScript)
# Copy this file to api/.env and adjust as needed.

PORT=4000
DATABASE_URL=postgresql://postgres@localhost:5432/heyrah_dev

# Deployment secret (32+ chars, random) — MUST be replaced with a real random value
# before any real deployment (never commit api/.env).
SESSION_SECRET=change-me-to-a-random-32-char-minimum-value

# CORS allowlist — the web origin only
API_ALLOWED_ORIGIN=http://localhost:5173

NODE_ENV=development

# Payment mode (ARCHITECTURE 5.5): "demo" mounts the demo payment simulator
# for local/demo environments; "manual" (default, production) disables it —
# only admin manual confirmation can mark an order PAID.
PAYMENT_MODE=demo

# v1 shipping in INR: flat rate, free at or above the threshold
SHIPPING_FLAT_RATE=99.00
SHIPPING_FREE_THRESHOLD=2999.00

# Admin product image storage (re-encoded uploads) and size cap in bytes
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5000000

# Public catalog reads per IP per minute (search/browse burst-cooling)
CATALOG_RATE_LIMIT_MAX=300

# Admin sessions end after this many idle minutes (customers: SESSION_IDLE_TTL_HOURS)
ADMIN_SESSION_IDLE_TTL_MINUTES=60

# Public storefront origin for canonical URLs, sitemap and robots.txt (defaults to API_ALLOWED_ORIGIN).
# REQUIRED in production, and must equal API_ALLOWED_ORIGIN there.
# PUBLIC_SITE_URL=https://REPLACE_WITH_YOUR_DOMAIN

# Reverse proxies in front of the API whose X-Forwarded-For is trusted (0 = none).
# REQUIRED in production (compose: 1 = web server; behind a TLS proxy too: 2).
# TRUST_PROXY_HOPS=0

# Logs: json (production default) or pretty (development default)
# LOG_FORMAT=pretty

# Production refuses PAYMENT_MODE=demo unless this is set to I_UNDERSTAND_NO_REAL_PAYMENTS
# (public demo deployments only). Leave unset for real stores.
# ALLOW_DEMO_PAYMENT_IN_PRODUCTION=

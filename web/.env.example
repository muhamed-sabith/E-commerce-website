# API base URL — consumed via import.meta.env.VITE_API_URL
# Copy this file to web/.env and adjust as needed.
VITE_API_URL=http://localhost:4000

# Canonical origin for production builds (must equal the API's PUBLIC_SITE_URL).
# Leave unset in development (the page's own origin is used).
# VITE_SITE_URL=https://REPLACE_WITH_YOUR_DOMAIN
